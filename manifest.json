{
  "manifest_version": 3,
  "name": "ESOS AI",
  "version": "4.0.11",
  "description": "ESOS AI Browser Extension für LinkedIn/XING Profil-Import, Socialmedia-Profilbilder, Netzwerk-Projekte, positionsgenauen Hintergrundabgleich, Outreach und Social Publishing.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.xing.com/*",
    "https://*.xing.com/*",
    "https://xing.com/*",
    "https://*.licdn.com/*",
    "https://*.xingassets.com/*",
    "https://images.ctfassets.net/*",
    "https://esos-web-production.up.railway.app/*",
    "https://boot-outreach-api-production.up.railway.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker-v411.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://linkedin.com/*",
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "profile-photo-dom-fix.js",
        "social-photo-content-fastpath-v406.js",
        "social-photo-content-bridge.js",
        "position-profile-parser.js",
        "linkedin-profile-identity-v411.js",
        "content.js"
      ]
    },
    {
      "matches": [
        "https://xing.com/*",
        "https://www.xing.com/*",
        "https://*.xing.com/*"
      ],
      "js": [
        "xing-search-location.js",
        "profile-photo-dom-fix.js",
        "social-photo-content-fastpath-v406.js",
        "social-photo-content-bridge.js",
        "profile-identity-v407.js",
        "content.js"
      ]
    }
  ],
  "key": ""
}
