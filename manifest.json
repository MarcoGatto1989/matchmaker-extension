{
  "manifest_version": 3,
  "name": "ESOS AI",
  "version": "4.1.2",
  "description": "ESOS AI Unified: CRM-Import, Outreach, Network Sync mit LinkedIn Sales Navigator und XING TalentManager, Positionsabgleich, Profilanreicherung, Social Publishing und LinkedHelper in einer Extension.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.xing.com/*",
    "https://*.xing.com/*",
    "https://xing.com/*",
    "https://*.licdn.com/*",
    "https://*.xingassets.com/*",
    "https://images.ctfassets.net/*",
    "https://app.esos.cloud/*",
    "https://boot-outreach-api-production.up.railway.app/*",
    "https://esos-frontend-test.up.railway.app/*",
    "https://esos.cloud/*",
    "https://www.esos.cloud/*"
  ],
  "action": {
    "default_popup": "popup-v415.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker-v421.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://linkedin.com/*",
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "profile-photo-dom-fix.js",
        "social-photo-content-fastpath-v406.js",
        "social-photo-content-bridge.js",
        "position-profile-parser.js",
        "linkedin-position-background-v420.js",
        "linkedin-profile-identity-v411.js",
        "content.js",
        "manual-outreach-v421.js",
        "linkedhelper-auto-panel-v421.js"
      ]
    },
    {
      "matches": [
        "https://xing.com/*",
        "https://www.xing.com/*",
        "https://*.xing.com/*"
      ],
      "js": [
        "xing-search-location.js",
        "profile-photo-dom-fix.js",
        "social-photo-content-fastpath-v406.js",
        "social-photo-content-bridge.js",
        "profile-identity-v407.js",
        "content.js",
        "manual-outreach-v421.js",
        "linkedhelper-auto-panel-v421.js"
      ]
    },
    {
      "matches": [
        "https://app.esos.cloud/*",
        "https://esos.cloud/*",
        "https://www.esos.cloud/*",
        "https://esos-frontend-test.up.railway.app/*"
      ],
      "js": [
        "esos-socialfinder-handoff-v421.js"
      ]
    }
  ],
  "key": ""
}